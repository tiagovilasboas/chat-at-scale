# Backend environment variables
# Copy this file to .env and fill in the values
# NEVER commit the .env file to git

# PostgreSQL connection string
DATABASE_URL=postgres://chat:password@localhost:5432/chat_at_scale

# JWT signing secret — MUST be a long random string in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_in_production_use_a_random_64_byte_hex_string

# Server port
PORT=8080

# Browser origin allowed to send credentialed requests (cookies).
# Never set this to * while credentials are true — browsers reject it and it is unsafe.
# Dev default in code is http://localhost:5173 (Vite).
CORS_ORIGIN=http://localhost:5173
