# Optional. The running client does not read these: Vite proxies /api and /ws
# to localhost:8080 so the HttpOnly cookie is same-origin.
# Keep them as a reminder if a future build talks to the gateway without a proxy.
# NEVER commit a real .env.

# VITE_API_URL=http://localhost:8080
# VITE_WS_URL=ws://localhost:8080

